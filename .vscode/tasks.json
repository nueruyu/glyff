{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "repomix: Generate Markdown & Copy to Clipboard",
      "type": "shell",
      // OS-specific configurations will be defined below
      "windows": {
        // On Windows, run the PowerShell script
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/.vscode/scripts/run_repomix.ps1",
          "${workspaceFolder}/.vscode/repomix/${input:repomixConfig}"
        ]
      },
      "linux": {
        // On Linux, run the shell script
        "command": "${workspaceFolder}/.vscode/scripts/run_repomix.sh",
        "args": ["${workspaceFolder}/.vscode/repomix/${input:repomixConfig}"]
      },
      "osx": {
        // On macOS, also run the shell script
        "command": "${workspaceFolder}/.vscode/scripts/run_repomix.sh",
        "args": ["${workspaceFolder}/.vscode/repomix/${input:repomixConfig}"]
      },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "repomixConfig",
      "type": "pickString",
      "description": "Select a repomix configuration profile to use",
      "options": [
        {
          "label": "Default",
          "value": "default.config.json"
        }
      ],
      "default": "default.config.json"
    }
  ]
}
